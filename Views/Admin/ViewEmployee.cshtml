@model ViewEmployeeVM
@using AttendanceApp.Helpers
@{
    ViewData["Title"] = "Employee Details";
    var shiftTime = ShiftHelper.GetShiftTime(Model.CurrentShift, Model.BaseDate);
    var now = DateTime.Now;
    var inWorkingShift = now >= shiftTime.Start && now <= shiftTime.End;
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<h2>👨‍💼 Employee Profile</h2>
<hr />
<div class="card p-4">
    <h4>Employee Info</h4>
    <p><strong>Name:</strong> @Model.Employee.FullName</p>
    <p><strong>Employee ID:</strong> @Model.Employee.EmployeeId</p>
    <p><strong>Email:</strong> @Model.Employee.Email</p>
    <p><strong>Phone:</strong> @Model.Employee.PhoneNumber</p>
    <p><strong>Device ID:</strong> @Model.Employee.DeviceId</p>

    <div class="mt-3">
        <a asp-controller="Admin" asp-action="EditEmployee" asp-route-id="@Model.Employee.Id" class="btn btn-warning mybtn1">✏️ Edit</a>

        <form asp-action="DeleteEmployee" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Employee.Id" />
            <button type="submit" class="btn btn-danger mybtn1" onclick="return confirm('Are you sure you want to delete this employee?')">🗑 Delete</button>
        </form>

        <form asp-action="ResetDevice" asp-route-id="@Model.Employee.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-secondary mybtn1" onclick="return confirm('Are you sure you want to reset the device binding?')">🔁 Reset Device</button>
        </form>
    </div>
</div>

<hr />
<h4 class="mt-4">🕘 Attendance Status - <strong>@Model.CurrentShift</strong> | <strong>@Model.BaseDate.ToString("yyyy-MM-dd")</strong></h4>

@if (Model.Request != null)
{
    <p><strong>Request Status:</strong> @Model.Request.Status</p>
    <p><strong>Requested Section:</strong> @Model.Request.Section</p>
    <p><strong>Requested At:</strong> @Model.Request.RequestedAt.ToString("g")</p>

    @if (Model.Request.Status == "Rejected")
    {
        <div class="alert alert-danger">❌ This shift was rejected.</div>
    }
    else if (Model.Request.Status == "Accepted" && inWorkingShift)
    {
        <div class="alert alert-success">✅ Currently working in this shift.</div>
    }
    else if (Model.Request.Status == "Accepted" && now > shiftTime.End)
    {
        <div class="alert alert-success">✅ Marked as present for this shift.</div>
    }
}
else
{
    <p><em>No attendance request received for this shift.</em></p>
}

@if (!Model.AlreadyMarked)
{
    <form asp-action="MarkAttendance" method="post" class="mt-3" onsubmit="return confirmSubmit();">
        <input type="hidden" name="UserId" value="@Model.Employee.Id" />
        <input type="hidden" name="Shift" value="@Model.CurrentShift" />
        <input type="hidden" name="BaseDate" value="@Model.BaseDate.ToString("yyyy-MM-dd")" />

        <div class="mb-2">
            <label for="Section">Section</label>
            <select id="sectionSelect" name="Section" class="form-control" required onchange="checkSectionMismatch()">
                <option value="">Select Section</option>
                <option value="ICU">ICU</option>
                <option value="Outdoor">Outdoor</option>
            </select>
        </div>

        <button  type="submit" name="Status" value="Accepted" class="btn btn-success me-2 mybtn" onclick="return checkShiftLimit();">✅ Accept (Mark Present)</button>
        <button type="submit" name="Status" value="Rejected" class="btn btn-danger mybtn">❌ Reject (Mark Absent)</button>
    </form>
}
else
{
    <div class="alert alert-info mt-3">
        ✅ Attendance already marked as <strong>@Model.Request?.Status</strong>.
    </div>
}
@if (Model.Stats != null && Model.Stats.MonthlyStats.Any())
{
    <h4 class="mt-4">📊 Monthly Attendance Summary @DateTime.Now.Year</h4>

    
    <div class="table-responsive" id="table-scroll-container">
        <table class="table table-bordered" id="table1">
            <thead class="table-dark">
                <tr>
                    <th>Month</th>
                    <th>Present</th>
                    <th>Overtime</th>
                    <th>Absent</th>
                    <th>Total Present</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Stats.MonthlyStats.Count; i++)
                {
                    var stat = Model.Stats.MonthlyStats[i];
                    <tr data-month="@stat.MonthYear">
                        <td>@stat.MonthYear</td>
                        <td>@stat.Present</td>
                        <td>@stat.Overtime</td>
                        <td>@stat.Absent</td>
                        <td>@(stat.Present + stat.Overtime)</td>
                        <td>
                            <a class="btn btn-primary btn-sm"
                               asp-controller="Admin"
                               asp-action="MonthlyDetails"
                               asp-route-userId="@Model.Employee.Id"
                               asp-route-month="@stat.Month"
                               asp-route-year="@stat.Year">
                                View Details
                            </a>
                        </td>
                    </tr>

                    
                 
                }
            </tbody>
        </table>
    </div>
    <p class="text-danger">Note:  Attendance In Table is Only Up To Yesterday</p>
   
}
else
{
    <div class="alert alert-info">No attendance stats found for this employee.</div>
}

@functions {
    public int GetMonthIndex(string monthName)
    {
        return monthName switch
        {
            "January" => 1,
            "February" => 2,
            "March" => 3,
            "April" => 4,
            "May" => 5,
            "June" => 6,
            "July" => 7,
            "August" => 8,
            "September" => 9,
            "October" => 10,
            "November" => 11,
            "December" => 12,
            _ => DateTime.Now.Month
        };
    }
}
@section Scripts {
    <script>
        const acceptedCount = @Model.MarkedShifts.Count;

        function checkShiftLimit() {
            if (acceptedCount >= 2) {
                return confirm("⚠️ Two shifts already accepted. Are you sure you want to accept a third shift for this employee?");
            }
            return true;
        }

        function checkSectionMismatch() {
            const requested = "@Model.Request?.Section".toLowerCase();
            const selected = document.getElementById("sectionSelect").value.toLowerCase();

            if (requested && selected && requested !== selected) {
                alert("⚠️ Warning: Section mismatch! Employee requested " + requested + ", but you selected " + selected);
            }
        }

        function confirmSubmit() {
            return confirm("Are you sure you want to submit this attendance decision?");
        }
    </script>
    <script>
        window.addEventListener("load", function () {
            const container = document.getElementById("table-scroll-container");
            const table = document.getElementById("table1");

            if (container && table) {
                // Scroll to the last part of the table (rightmost)
                container.scrollLeft = table.scrollWidth - container.clientWidth;
            }
        });
    </script>
   
}
