                            <label class="form-check-label" for="sectionOutdoor">Outdoor</label>
                        </div><br />
                        <button type="submit" class="btn btn-primary">Ask for Overtime</button>


                    </form>
                }
                else
                {
                    <form id="AttedanceForm" asp-action="SendAttendanceRequest" method="post">
                        <input type="hidden" name="Shift" value="@shift" />
                        <input type="hidden" name="BaseDate" value="@Model.BaseDate.ToString("yyyy-MM-dd")" />

                        @* <select name="Section" class="form-control mb-2" required>
                        <option value="">Select</option>
                        <option value="ICU">ICU</option>
                        <option value="Outdoor">Outdoor</option>
                    </select> *@
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Section" value="ICU" id="sectionICU" required>
                            <label class="form-check-label" for="sectionICU">ICU</label>

                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Section" value="Outdoor" id="sectionOutdoor">
                            <label class="form-check-label" for="sectionOutdoor">Outdoor</label>
                        </div><br />
                        <button type="submit" class="btn btn-primary">Ask for Attendance</button>

                    </form>

                }
           }
        
            
        }
        else if (Model.MarkedShifts.Count == 1 && isAfterCurrent&& shiftTime.Start > now)
        {
             

           @*  <form asp-action="SendAttendanceRequest" method="post" class="d-inline">
                <input type="hidden" name="Shift" value="@shift" />
                <input type="hidden" name="BaseDate" value="@Model.BaseDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="Section" value="Outdoor" /> <!-- or bind dynamically -->

                <button type="button" id="@btnId" class="btn btn-warning"
                        onclick="checkShiftStartTime('@shiftTime.Start.ToString("yyyy-MM-ddTHH:mm:ss")', '@btnId')">
                    Request Overtime
                </button>
            </form> *@ 
                   <button class="btn btn-secondary" disabled>Ask for Overtime</button>
                   @* <span class="text-warning">🕐 Wait Until this Shift Start</span> *@
            
            
            
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled>Unavailable</button>
        }
    </div>
}
@if (Model.Stats != null && Model.Stats.MonthlyStats.Any())
{
    <h4 class="mt-4">📊 Monthly Attendance Summary @DateTime.Now.Year</h4>

   
    <div class="table-responsive" id="table-scroll-container">
        <table class="table table-bordered" id="table1" >
            <thead class="table-dark">
                <tr>
                    <th>Month</th>
                    <th>Present</th>
                    <th>Overtime</th>
                    <th>Absent</th>
                    <th>Total Present</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Stats.MonthlyStats.Count; i++)
                {
                    var stat = Model.Stats.MonthlyStats[i];
                    <tr data-month="@stat.MonthYear">
                        <td>@stat.MonthYear</td>
                        <td>@stat.Present</td>
                        <td>@stat.Overtime</td>
                        <td>@stat.Absent</td>
                        <td>@(stat.Present + stat.Overtime)</td>
                        <td>
                            <a class="btn btn-primary btn-sm view"
                               asp-controller="Employee"
                               asp-action="MonthlyDetails"
                               asp-route-userId="@Model.Employee.Id"
                               asp-route-month="@stat.Month"
                               asp-route-year="@stat.Year">
                                View Details
                            </a>
                        </td>
                    </tr>

                    <!-- Collapsible Day-wise Shift Table -->
                }
            </tbody>
        </table>
    </div>
    <p class="text-danger">Note:  Attendance In Table is Only Up To Yesterday</p>

}
else
{
    <div class="alert alert-info">No attendance stats found for this employee.</div>
}

@functions {
    public int GetMonthIndex(string monthName)
    {
        return monthName switch
        {
            "January" => 1,
            "February" => 2,
            "March" => 3,
            "April" => 4,
            "May" => 5,
            "June" => 6,
            "July" => 7,
            "August" => 8,
            "September" => 9,
            "October" => 10,
            "November" => 11,
            "December" => 12,
            _ => DateTime.Now.Month
        };
    }
}

@section Scripts {
    <script>
        function checkShiftStartTime(shiftStart, btnId) {
            const now = new Date();
            const shiftTime = new Date(shiftStart);

            if (now < shiftTime) {
                alert("⏳ Please wait until the shift start time.");
                return false;
            }

            document.getElementById(btnId).closest("form").submit();
        }
    </script>
    <script>
      function submitWithAlert() {
        alert("✅ Request sent successfully!");
        document.getElementById("AttendanceForm").submit();
      }
    </script>
     <script>
        window.addEventListener("load", function () {
            const container = document.getElementById("table-scroll-container");
            const table = document.getElementById("table1");

            if (container && table) {
                // Scroll to the last part of the table (rightmost)
                container.scrollLeft = table.scrollWidth - container.clientWidth;
            }
        });
    </script>
}






