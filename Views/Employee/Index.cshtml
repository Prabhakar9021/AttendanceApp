            }
            else if(now>shiftTime.End)
            {
                
                <button class="btn btn-secondary" disabled>✅Marked As Present.</button>
            }
         
        } 
        else if (isPending)
        {

            <button class="btn btn-secondary" disabled>🕐 Request Pending</button>
            @* <span class="text-warning">📨 Attendance request sent. <strong>Waiting for admin approval...</strong></span> *@
        }
        else if (Model.ExistingRequest != null && Model.ExistingRequest.Shift == shift)
        {
            
