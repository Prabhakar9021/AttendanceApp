<hr /> 


@functions {
    public class ShiftTimeRange
    {
        public ShiftType Shift { get; set; }
        public TimeSpan Start { get; set; }
        public TimeSpan End { get; set; }

        public DateTime GetStartDateTime(DateTime baseDate)
        {
            return baseDate.Add(Start);
        }

        public DateTime GetEndDateTime(DateTime baseDate)
        {
            // If shift ends before it starts, it means it crosses midnight (e.g., night shift)
            return Start < End
                ? baseDate.Add(End)
                : baseDate.AddDays(1).Add(End);
        }
    }

    ShiftTimeRange GetShiftTime(ShiftType shift)
    {
        return shift switch
        {
            ShiftType.Morning => new ShiftTimeRange
                {
                    Shift = ShiftType.Morning,
                    Start = TimeSpan.FromHours(8),
                    End = TimeSpan.FromHours(14)
                },
            ShiftType.Evening => new ShiftTimeRange
                {
                    Shift = ShiftType.Evening,
                    Start = TimeSpan.FromHours(14),
                    End = TimeSpan.FromHours(20)
                },
            ShiftType.Night => new ShiftTimeRange
                {
                    Shift = ShiftType.Night,
                    Start = TimeSpan.FromHours(20),
                    End = TimeSpan.FromHours(8)
                },
            _ => null
        };
    }
}

@{
    var now = DateTime.Now.TimeOfDay;
}

<h3>Attendance Request</h3>
<h5>Today's Current Shift: @Model.CurrentShift (@Model.BaseDate.ToString("yyyy-MM-dd"))</h5>


